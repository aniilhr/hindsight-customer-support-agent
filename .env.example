# ---- Hindsight (memory) -------------------------------------------------------------
# Option A: Hindsight Cloud  -> https://ui.hindsight.vectorize.io  (promo code MEMHACK99 in Billing)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
# Option B: self-hosted via Docker (see README) -> no key needed
# HINDSIGHT_BASE_URL=http://localhost:8888

# Prefix for memory bank ids (shiprelay-customer-c1001, shiprelay-playbook, ...)
HINDSIGHT_BANK_PREFIX=shiprelay

# ---- LLM for the agent (any OpenAI-compatible endpoint; Groq by default) -------------
# Free key: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3-32b
